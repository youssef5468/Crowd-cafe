{
  "name": "crowd-coffee",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @crowd/api\" \"npm run dev -w @crowd/web\"",
    "build": "npm run build -w @crowd/shared && npm run build -w @crowd/api && npm run build -w @crowd/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build -w @crowd/shared && vitest run",
    "db:local": "node scripts/local-postgres.mjs",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:push": "prisma db push --schema apps/api/prisma/schema.prisma",
    "db:seed": "tsx apps/api/prisma/seed.ts",
    "lint": "eslint .",
    "format": "prettier --write apps packages scripts *.md",
    "db:deploy": "prisma migrate deploy --schema apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9.39.0",
    "lighthouse": "^13.6.0",
    "prettier": "^3.6.2",
    "prisma": "6.19.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0",
    "minimatch": "^11.0.1"
  }
}
