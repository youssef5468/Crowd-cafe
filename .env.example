# Crowd Coffee development. Use npm run db:local to generate isolated local credentials.
DATABASE_URL=postgresql://crowd:SET_LOCAL_PASSWORD@127.0.0.1:54340/crowd_utf8?schema=public
JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
WEB_ORIGIN=http://localhost:5184,http://127.0.0.1:5184
PORT=4011
HOST=127.0.0.1
NODE_ENV=development
SEED_ADMIN_EMAIL=owner@crowd.local
SEED_ADMIN_PASSWORD=GENERATE_A_RANDOM_PASSWORD_AT_LEAST_12_CHARACTERS
UPLOAD_STORAGE=local
PUBLIC_URL=
# Optional production Cloudinary integration; never copy credentials from cg.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
